[Unit]
Description=Prometheus WireGuard Exporter
Documentation=https://github.com/donkeysharp/wireguard-exporter
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
# Reading WireGuard state over netlink requires CAP_NET_ADMIN.
AmbientCapabilities=CAP_NET_ADMIN
EnvironmentFile=-/etc/default/wireguard_exporter
ExecStart=/usr/local/bin/wireguard_exporter $WIREGUARD_EXPORTER_OPTS
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
